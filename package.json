{
  "name": "pi-config",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Pi extensions, skills, and themes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/redasalmi/pi-config.git"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-theme"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test": "npm run test:review && npm run test:workflow",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --project extensions/tsconfig.json",
    "test:review": "node --test extensions/review/tests/*.test.ts",
    "test:workflow": "node --test extensions/workflow/tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-server": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "22.19.19",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.82.0",
    "typebox": "^1.3.34",
    "typescript": "7.0.2"
  }
}
