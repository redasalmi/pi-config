{
  "name": "pi-config",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Pi extensions, skills, and themes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/redasalmi/pi-config.git"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-theme"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --project extensions/tsconfig.json",
    "test:browser": "node --test extensions/browser/tests/browser.test.ts",
    "test:browser:smoke": "node --test extensions/browser/tests/smoke.test.ts",
    "test:codex": "node --test extensions/codex/tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  }
}
